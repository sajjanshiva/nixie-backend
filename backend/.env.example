# Shopify (Client Credentials Grant - see Dev Dashboard app setup)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# ImageKit
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/yourid

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Google Sheets (live pricing + category + description data)
GOOGLE_SHEET_ID=your_sheet_id_from_the_url
GOOGLE_SERVICE_ACCOUNT_EMAIL=nixie-sheet-reader@your-project.iam.gserviceaccount.com
# Paste the "private_key" value from your service account JSON key EXACTLY as-is,
# including the \n sequences - do not convert them to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
PRICING_REFRESH_INTERVAL_MINUTES=15

PORT=5000
